# Credenciais da API Higgsfield — gere em https://cloud.higgsfield.ai/
# Copie este arquivo para .env e preencha UMA das opções abaixo.

# Opção 1: chave única no formato "API_KEY:API_SECRET"
HF_KEY=

# Opção 2: chave e segredo separados (usados só se HF_KEY estiver vazio)
HF_API_KEY=
HF_API_SECRET=
