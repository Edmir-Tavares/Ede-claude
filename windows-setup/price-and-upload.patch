--- /dev/null
+++ b/src/app/api/upload/route.ts
@@ -0,0 +1,62 @@
+import { NextResponse } from "next/server";
+
+import { MissingCredentialsError } from "@/generation/credentials";
+import { createPlatformClient } from "@/generation/platform";
+import { readCredentials } from "@/generation/server-credentials";
+
+/* Inputs go to the generation platform's own storage: one presigned URL per
+   file, filled from here so the browser never needs the key or the storage's
+   CORS rules. The public URL that comes back is what the generate request
+   carries. */
+
+const ALLOWED = new Set([
+  "image/jpeg",
+  "image/jpg",
+  "image/png",
+  "image/webp",
+  "image/gif",
+  "audio/wav",
+  "audio/x-wav",
+  "video/mp4",
+]);
+const MAX_BYTES = 200 * 1024 * 1024;
+
+export async function POST(request: Request): Promise<NextResponse> {
+  const contentType = (request.headers.get("content-type") ?? "").split(";")[0]!.trim().toLowerCase();
+  if (!ALLOWED.has(contentType)) {
+    return NextResponse.json(
+      { error: `Unsupported file type ${contentType || "(none)"}. Use JPEG, PNG, WebP, GIF, MP4 or WAV.` },
+      { status: 415 },
+    );
+  }
+  const declared = Number(request.headers.get("content-length") ?? 0);
+  if (declared > MAX_BYTES) {
+    return NextResponse.json({ error: "File is larger than 200 MB" }, { status: 413 });
+  }
+
+  try {
+    const file = await request.arrayBuffer();
+    if (file.byteLength === 0) return NextResponse.json({ error: "Empty file" }, { status: 400 });
+    if (file.byteLength > MAX_BYTES) {
+      return NextResponse.json({ error: "File is larger than 200 MB" }, { status: 413 });
+    }
+
+    const client = createPlatformClient(await readCredentials());
+    const target = await client.uploadTarget(contentType);
+    const put = await fetch(target.uploadUrl, {
+      method: "PUT",
+      headers: { "Content-Type": contentType, ...target.uploadHeaders },
+      body: file,
+    });
+    if (!put.ok) throw new Error(`Storage refused the file (${put.status})`);
+    console.info("[upload] stored", { contentType, bytes: file.byteLength, url: target.publicUrl });
+    return NextResponse.json({ url: target.publicUrl });
+  } catch (caught) {
+    if (caught instanceof MissingCredentialsError) {
+      return NextResponse.json({ error: "Add your platform key before uploading" }, { status: 401 });
+    }
+    const message = caught instanceof Error ? caught.message : String(caught);
+    console.error("[upload] failed", message);
+    return NextResponse.json({ error: message }, { status: 502 });
+  }
+}
