index 0000000..f273c81
--- /dev/null
+++ b/src/openhiggsfield/price.tsx
@@ -0,0 +1,130 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+import { assemblePlane } from "@/generation/plane";
+import { useActive } from "@/generation/stores/active";
+import { useImageMedia, useVideoMedia } from "@/generation/stores/media";
+import { useImagePrompt, useVideoPrompt } from "@/generation/stores/prompt";
+import { useSettings } from "@/generation/stores/settings";
+
+type Quote = { credits: string; usd: string };
+type PriceState =
+  | { kind: "idle"; text: string }
+  | { kind: "loading" }
+  | { kind: "ready"; quote: Quote }
+  | { kind: "error"; text: string; detail: string };
+
+/* A quote waits for typing to settle: the platform prices the whole request,
+   prompt included, and a call per keystroke would only be thrown away. */
+const SETTLE_MS = 550;
+
+/** What pressing Generate will cost, quoted by the platform for exactly the
+    request the press would send. `requests` is how many times that request
+    goes out — a studio-side batch is several identical submits. */
+export function PriceTag({ requests, keyConfigured }: { requests: number; keyConfigured: boolean }) {
+  const surface = useActive((state) => state.surface);
+  const modelId = useActive((state) => state.model);
+  const text = (surface === "image" ? useImagePrompt : useVideoPrompt)((state) => state.text);
+  const items = (surface === "image" ? useImageMedia : useVideoMedia)((state) => state.items);
+  const byModel = useSettings((state) => state.byModel[modelId]);
+  const [state, setState] = useState<PriceState>({ kind: "idle", text: "" });
+
+  const mediaKey = items.map((item) => `${item.role}:${item.url}`).join("|");
+  const settingsKey = JSON.stringify(byModel ?? {});
+
+  useEffect(() => {
+    if (!keyConfigured) {
+      setState({ kind: "idle", text: "Add your key to see the price" });
+      return;
+    }
+    if (!text.trim()) {
+      setState({ kind: "idle", text: "Write a prompt to see the price" });
+      return;
+    }
+    if (items.some((item) => item.url.startsWith("blob:"))) {
+      setState({ kind: "idle", text: "Waiting for the upload…" });
+      return;
+    }
+
+    const controller = new AbortController();
+    setState({ kind: "loading" });
+    const timer = window.setTimeout(async () => {
+      try {
+        const res = await fetch("/api/estimate", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify(assemblePlane()),
+          signal: controller.signal,
+        });
+        const payload = (await res.json().catch(() => null)) as
+          | (Partial<Quote> & { error?: unknown })
+          | null;
+        if (res.status === 401) {
+          setState({ kind: "idle", text: "Add your key to see the price" });
+          return;
+        }
+        if (!res.ok || typeof payload?.usd !== "string" || typeof payload.credits !== "string") {
+          const detail = typeof payload?.error === "string" ? payload.error : `HTTP ${res.status}`;
+          setState({ kind: "error", text: "Price unavailable", detail });
+          return;
+        }
+        setState({ kind: "ready", quote: { credits: payload.credits, usd: payload.usd } });
+      } catch (caught) {
+        if (controller.signal.aborted) return;
+        const detail = caught instanceof Error ? caught.message : String(caught);
+        setState({ kind: "error", text: "Price unavailable", detail });
+      }
+    }, SETTLE_MS);
+
+    return () => {
+      controller.abort();
+      window.clearTimeout(timer);
+    };
+    // The keys stand in for the arrays and objects they summarise.
+  }, [keyConfigured, modelId, text, mediaKey, settingsKey]);
+
+  if (state.kind === "loading") {
+    return (
+      <span className="ohf-price" data-state="loading" aria-live="polite">
+        Pricing…
+      </span>
+    );
+  }
+  if (state.kind === "idle") {
+    return state.text ? (
+      <span className="ohf-price" data-state="idle">
+        {state.text}
+      </span>
+    ) : null;
+  }
+  if (state.kind === "error") {
+    return (
+      <span className="ohf-price ohf-tip" data-state="error" data-tip={state.detail}>
+        {state.text}
+      </span>
+    );
+  }
+
+  const { usd, credits } = totals(state.quote, requests);
+  const each = requests > 1 ? ` (${requests} × $${state.quote.usd})` : "";
+  return (
+    <span
+      className="ohf-price"
+      data-state="ready"
+      aria-live="polite"
+      title={`Platform estimate for this exact request${each}. Failed and moderated runs are not charged.`}
+    >
+      <span className="ohf-price-usd">${usd}</span>
+      <span className="ohf-price-credits">{credits} credits</span>
+    </span>
+  );
+}
+
+/* The quote is per request. Multiplying in whole thousandths keeps a sum like
+   3 × 0.094 from printing as 0.28200000000000003. */
+function totals(quote: Quote, requests: number) {
+  if (requests <= 1) return { usd: quote.usd, credits: quote.credits };
+  const scale = (value: string) => ((Math.round(Number(value) * 1000) * requests) / 1000).toFixed(3);
+  return { usd: scale(quote.usd), credits: scale(quote.credits) };
+}
