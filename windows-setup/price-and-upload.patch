diff --git a/src/generation/server-credentials.ts b/src/generation/server-credentials.ts
new file mode 100644
index 0000000..c580721
--- /dev/null
+++ b/src/generation/server-credentials.ts
@@ -0,0 +1,20 @@
+import { cookies } from "next/headers";
+
+import { MissingCredentialsError, PLATFORM_KEY_COOKIE, decodeCredentials } from "./credentials";
+
+/* Shared by the server actions and the route handlers. It lives outside
+   actions.ts because every export of a "use server" module is callable from
+   the browser, and the key must never be. */
+
+export async function readStoredCredentials() {
+  const jar = await cookies();
+  return decodeCredentials(jar.get(PLATFORM_KEY_COOKIE)?.value);
+}
+
+export async function readCredentials() {
+  const stored = await readStoredCredentials();
+  if (!stored) throw new MissingCredentialsError();
+  const baseUrl = process.env.HF_API_BASE_URL;
+  if (!baseUrl) throw new Error("Missing HF_API_BASE_URL");
+  return { ...stored, baseUrl };
+}
