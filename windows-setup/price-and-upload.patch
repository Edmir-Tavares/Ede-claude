diff --git a/src/app/api/estimate/route.ts b/src/app/api/estimate/route.ts
new file mode 100644
index 0000000..42dbd56
--- /dev/null
+++ b/src/app/api/estimate/route.ts
@@ -0,0 +1,67 @@
+import { NextResponse } from "next/server";
+
+import { getModel, parseSettings } from "@/generation/catalog";
+import type { GenerationPlane, MediaItem, MediaRole } from "@/generation/catalog/types";
+import { MissingCredentialsError } from "@/generation/credentials";
+import { PlatformError, createPlatformClient } from "@/generation/platform";
+import { readCredentials } from "@/generation/server-credentials";
+import { toPlatform } from "@/generation/to-platform";
+
+/* A route rather than a server action: Next runs a client's server actions one
+   at a time, so a quote refreshed on every keystroke would queue in front of
+   the Generate press it is meant to inform. */
+
+const ROLES: readonly MediaRole[] = ["start", "end", "reference", "video", "audio"];
+
+export async function POST(request: Request): Promise<NextResponse> {
+  let plane: GenerationPlane;
+  try {
+    plane = parsePlane(await request.json());
+  } catch (caught) {
+    return NextResponse.json({ error: messageOf(caught) }, { status: 400 });
+  }
+
+  try {
+    const model = getModel(plane.model);
+    const { path, body } = toPlatform({ ...plane, settings: parseSettings(model, plane.settings) });
+    const estimate = await createPlatformClient(await readCredentials()).estimate(path, body);
+    return NextResponse.json(estimate);
+  } catch (caught) {
+    if (caught instanceof MissingCredentialsError) {
+      return NextResponse.json({ error: "missing-key" }, { status: 401 });
+    }
+    const status = caught instanceof PlatformError && caught.status >= 400 ? caught.status : 500;
+    return NextResponse.json({ error: messageOf(caught) }, { status });
+  }
+}
+
+function parsePlane(data: unknown): GenerationPlane {
+  const value = asRecord(data);
+  if (typeof value.model !== "string") throw new Error("Invalid model");
+  const text = asRecord(value.prompt).text;
+  if (typeof text !== "string") throw new Error("Invalid prompt");
+
+  const media: GenerationPlane["media"] = {};
+  const rawMedia = asRecord(value.media);
+  for (const role of ROLES) {
+    const list = rawMedia[role];
+    if (!Array.isArray(list)) continue;
+    media[role] = list.flatMap((item): MediaItem[] => {
+      const row = asRecord(item);
+      return typeof row.url === "string" && typeof row.id === "string"
+        ? [{ id: row.id, url: row.url, role }]
+        : [];
+    });
+  }
+  return { model: value.model, prompt: { text }, media, settings: asRecord(value.settings) };
+}
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function messageOf(caught: unknown): string {
+  return caught instanceof Error ? caught.message : String(caught);
+}
